.guide-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #ffffff;
  padding-bottom: calc(286rpx + env(safe-area-inset-bottom));
}

.guide-space {
  min-height: calc(100vh - 286rpx - env(safe-area-inset-bottom));
}

.composer-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 22rpx 16rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #e8e8e8;
}

.composer-card {
  min-height: 218rpx;
  box-sizing: border-box;
  padding: 30rpx 34rpx 22rpx;
  background: #ffffff;
  border-radius: 30rpx;
}

.composer-input {
  width: 100%;
  height: 116rpx;
  min-height: 116rpx;
  box-sizing: border-box;
  padding: 0;
  color: #111111;
  font-size: 32rpx;
  line-height: 44rpx;
  background: transparent;
}

.composer-placeholder {
  color: #9b9b9b;
}

.composer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

.plain-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 50%;
  line-height: 1;
  background: transparent;
}

.plain-button::after {
  display: none;
}

.plain-button-hover {
  opacity: 0.62;
}

.add-button {
  color: #111111;
  font-size: 46rpx;
  font-weight: 300;
}

.send-button {
  background: #111111;
}

.send-button-hover {
  background: #2b2b2b;
}

.send-arrow {
  width: 42rpx;
  height: 42rpx;
}
