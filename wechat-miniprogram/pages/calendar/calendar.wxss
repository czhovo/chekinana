.calendar-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #f6f7f9;
  font-family: "SF Pro Display Light", "SF Pro Display", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-weight: 300;
}

.calendar-card {
  width: 100%;
  padding: 12rpx 0 18rpx;
  border: 2rpx solid #d9dde5;
  border-radius: 12rpx;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.calendar-header {
  height: 60rpx;
  padding: 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.month-button {
  width: 72rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-arrow {
  color: #2563eb;
  font-size: 58rpx;
  line-height: 60rpx;
  font-weight: 200;
}

.month-picker {
  height: 60rpx;
  min-width: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.month-title {
  color: #202124;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 300;
  white-space: nowrap;
}

.month-caret {
  color: #2563eb;
  font-size: 34rpx;
  line-height: 1;
}

.calendar-divider {
  width: 64%;
  height: 2rpx;
  margin: 8rpx auto 8rpx;
  background: #eef0f4;
}

.weekday-row,
.calendar-week {
  display: flex;
  align-items: stretch;
}

.weekday-row {
  height: 46rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.weekday-cell {
  width: 14.2857%;
  flex: 0 0 14.2857%;
  color: #4b5563;
  font-size: 26rpx;
  font-weight: 200;
  line-height: 46rpx;
  text-align: center;
}

.calendar-grid {
  padding: 0 22rpx;
  box-sizing: border-box;
}

.calendar-week {
  height: 100rpx;
}

.date-cell {
  position: relative;
  width: 14.2857%;
  flex: 0 0 14.2857%;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #202124;
  font-size: 30rpx;
  font-weight: 200;
  line-height: 1;
  box-sizing: border-box;
}

.date-number {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.date-cell.is-muted {
  color: #a5abb5;
}

.date-cell.is-selected {
  color: #ffffff;
  font-weight: 300;
}

.date-cell.is-selected .date-number {
  background: #2563eb;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.22);
}

.selected-date-panel {
  margin-top: 28rpx;
}

.selected-date-header {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-date-title {
  position: relative;
  min-width: 0;
  padding-left: 18rpx;
  color: #202124;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1.3;
  white-space: nowrap;
}

.selected-date-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #2563eb;
  transform: translateY(-50%);
}

.selected-date-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-action-hitbox {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-11rpx);
}

.date-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
  box-sizing: border-box;
}

.add-action {
  border: 2rpx solid #2563eb;
  background: #2563eb;
  color: #ffffff;
}

.selected-records {
  min-height: 120rpx;
}

.calendar-record-card {
  min-height: 104rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.record-avatars {
  flex: 0 0 auto;
  min-width: 72rpx;
  display: flex;
  align-items: center;
}

.record-avatar-wrap {
  width: 58rpx;
  height: 58rpx;
  margin-left: -14rpx;
}

.record-avatar-wrap:first-child {
  margin-left: 0;
}

.record-avatar,
.record-avatar-color,
.record-avatar-placeholder,
.selected-idol-avatar,
.picker-avatar,
.detail-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-sizing: border-box;
  background: #d9dde5;
}

.record-avatar-placeholder {
  border-color: #d9dde5;
}

.record-card-body {
  min-width: 0;
  flex: 1 1 auto;
}

.record-card-title {
  color: #111827;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 400;
}

.record-card-note {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.records-empty {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 26rpx;
  font-weight: 300;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  padding: 56rpx 36rpx;
  background: rgba(15, 23, 42, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.top-mask {
  z-index: 1010;
}

.record-dialog,
.idol-picker-dialog {
  width: 100%;
  max-height: 86vh;
  padding: 34rpx;
  border-radius: 22rpx;
  border: 2rpx solid #e5e7eb;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.16);
  box-sizing: border-box;
  overflow: auto;
}

.dialog-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 500;
  text-align: center;
  margin-bottom: 28rpx;
}

.form-row {
  margin-top: 20rpx;
}

.form-label {
  color: #374151;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 300;
  margin-bottom: 10rpx;
}

.form-picker,
.form-input,
.form-textarea {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  border: 2rpx solid #d9dde5;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 78rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 128rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.35;
}

.selected-idols {
  min-height: 76rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
}

.selected-idol,
.idol-add-button {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.selected-idol-avatar {
  width: 68rpx;
  height: 68rpx;
}

.idol-add-button {
  border: 2rpx solid #2563eb;
  color: #2563eb;
  background: #ffffff;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
}

.dialog-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 18rpx;
}

.dialog-button {
  height: 76rpx;
  flex: 1 1 0;
  margin: 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.dialog-button::after {
  border: 0;
}

.dialog-button.primary {
  background: #2563eb;
  color: #ffffff;
}

.dialog-button.secondary {
  border: 2rpx solid #d1d5db;
  background: #ffffff;
  color: #111827;
}

.dialog-button.danger {
  background: #ef4444;
  color: #ffffff;
}

.idol-picker-list {
  max-height: 560rpx;
  overflow: auto;
}

.idol-picker-item {
  min-height: 92rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
  box-sizing: border-box;
}

.idol-picker-item.is-selected .picker-check {
  background: #2563eb;
  color: #ffffff;
}

.picker-idol-text {
  min-width: 0;
  flex: 1 1 auto;
}

.picker-idol-name {
  color: #111827;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 400;
}

.picker-idol-group {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.25;
}

.picker-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #2563eb;
  color: transparent;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
  box-sizing: border-box;
}

.detail-line {
  color: #111827;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.detail-idols {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-idol {
  min-width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.detail-idol-name {
  max-width: 140rpx;
  color: #374151;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-note {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #374151;
  font-size: 26rpx;
  line-height: 1.45;
}

.detail-meta {
  margin-top: 10rpx;
  color: #9ca3af;
  font-size: 21rpx;
  line-height: 1.3;
  text-align: center;
}

.three-actions {
  gap: 12rpx;
}
