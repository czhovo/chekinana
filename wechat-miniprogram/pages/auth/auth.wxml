<view class="auth-page with-bottom-nav">
  <view class="auth-panel">
    <view class="brand">Chekinana Scanner</view>
    <view class="title">Scanner 访问 Token</view>
    <view class="subtitle">此 Token 仅用于进入 Scanner 提取功能。</view>

    <input
      class="token-input"
      value="{{token}}"
      password="{{hideToken}}"
      placeholder="请输入 token"
      confirm-type="done"
      disabled="{{verifying}}"
      bindinput="onTokenInput"
      bindconfirm="verifyToken"
    />

    <view class="row">
      <label class="hide-toggle">
        <checkbox checked="{{hideToken}}" bindtap="toggleHideToken" color="#2563eb" />
        <text>隐藏输入</text>
      </label>
    </view>

    <button
      class="verify-button"
      loading="{{verifying}}"
      disabled="{{!token || verifying}}"
      bindtap="verifyToken"
    >
      {{verifying ? '验证中' : '进入Scanner'}}
    </button>

    <view class="error-text {{errorText ? 'is-visible' : ''}}">{{errorText || ' '}}</view>
  </view>
</view>
<bottom-nav active="scanner" />
