.placeholder-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #f6f7f9;
}

.placeholder-panel {
  width: 100%;
  padding: 32rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.placeholder-kicker {
  margin-bottom: 14rpx;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.placeholder-title {
  margin-bottom: 16rpx;
  color: #202124;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.placeholder-text {
  color: #6b7280;
  font-size: 28rpx;
  line-height: 1.6;
}

.settings-session {
  margin-top: 30rpx;
  padding: 24rpx;
  border: 2rpx solid #dbeafe;
  border-radius: 12rpx;
  background: #f8fbff;
}

.settings-session-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.settings-session-status {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.settings-session-status.is-logged-in {
  color: #047857;
}

.settings-session-status.is-logged-out {
  color: #6b7280;
}

.settings-session-message {
  margin-top: 10rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.5;
}

.settings-session-message--loading {
  color: #2563eb;
}

.settings-session-message--success {
  color: #047857;
}

.settings-session-message--error {
  color: #991b1b;
}

.settings-session-detail {
  margin-top: 10rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.settings-sync {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #d9dde5;
  border-radius: 12rpx;
  background: #ffffff;
}

.settings-sync-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.settings-sync-message {
  margin-top: 10rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.5;
}

.settings-sync-message--loading {
  color: #2563eb;
}

.settings-sync-message--success {
  color: #047857;
}

.settings-sync-message--error {
  color: #991b1b;
}

.settings-sync-detail {
  margin-top: 10rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.settings-section {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.settings-action,
button.settings-action {
  width: 100%;
  height: 88rpx;
  margin-top: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-section + .settings-action,
.settings-section + button.settings-action {
  margin-top: 32rpx;
}

.settings-contact-section {
  margin-top: 28rpx;
  margin-bottom: 28rpx;
}

.contact-link {
  color: #4b5563;
  font-size: 26rpx;
  text-align: center;
  text-decoration: underline;
}

.settings-action.secondary,
button.settings-action.secondary {
  background: #ffffff;
  color: #1f2937;
  border: 2rpx solid #d9dde5;
}

.settings-action.compact,
button.settings-action.compact {
  height: 72rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.settings-action::after,
button.settings-action::after {
  display: none;
  border: 0;
}

.contact-dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 40rpx 28rpx;
  background: rgba(17, 24, 39, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.contact-dialog {
  width: 100%;
  max-width: 680rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
}

.contact-dialog-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.contact-dialog-title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.contact-dialog-subtitle {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.contact-dialog-close {
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  color: #6b7280;
  font-size: 44rpx;
  line-height: 46rpx;
  text-align: center;
}

.contact-field {
  margin-bottom: 20rpx;
}

.contact-label {
  margin-bottom: 10rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.contact-label.optional {
  color: #4b5563;
  font-weight: 500;
}

.contact-message-input,
.contact-info-input {
  width: 100%;
  padding: 18rpx 20rpx;
  border: 2rpx solid #d9dde5;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.contact-message-input {
  height: 220rpx;
}

.contact-info-input {
  height: 76rpx;
}

.contact-dialog-actions {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 26rpx;
  box-sizing: border-box;
}

.contact-dialog-actions .contact-dialog-button,
.contact-dialog-actions button.contact-dialog-button {
  flex: 1 1 0%;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1f2937;
  border: 2rpx solid #d9dde5;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
}

.contact-dialog-actions .contact-dialog-button::after,
.contact-dialog-actions button.contact-dialog-button::after {
  display: none;
  border: 0;
}

.contact-dialog-actions .contact-dialog-button.primary,
.contact-dialog-actions button.contact-dialog-button.primary {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

.contact-dialog-actions .contact-dialog-button[disabled],
.contact-dialog-actions button.contact-dialog-button[disabled] {
  color: #a5abb5;
  background: #eef0f4;
  border-color: #eef0f4;
}
