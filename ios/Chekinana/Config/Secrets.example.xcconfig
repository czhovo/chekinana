// Copy this file to ignored Secrets.xcconfig and fill local values there.
// Keep real values out of git.
WEIBO_OPENAPI_ACCESS_TOKEN = <your-weibo-openapi-access-token>
WEIBO_OPENAPI_SOURCE =
CHEKINANA_SCANNER_POD_ID =

// Optional Scanner-only override. Leave empty for https://api.chekinana.top.
// Debug permits HTTP only for loopback/private-LAN hosts. In xcconfig, spell
// the two URL slashes as /$()/ so they are not parsed as a comment.
// Example: CHEKINANA_SCANNER_BASE_URL = http:/$()/192.168.1.50:8787
CHEKINANA_SCANNER_BASE_URL =
