    "product.assistant.executor.idol.delete_associated_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete %@?\nDelete: Cheki %lld, photos %lld, videos %lld; quantity records %lld (%lld Cheki); memories %lld, attachments %lld.\nKeep and unlink: Cheki %lld, photos %lld, videos %lld; quantity records %lld (%lld Cheki); memories %lld, attachments %lld.\nDeletion cannot be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を削除しますか？\n削除：チェキ %lld件、写メ %lld件、動画 %lld件、枚数レコード %lld件（%lld枚）、思い出 %lld件、添付 %lld件。\n保持・関連解除：チェキ %lld件、写メ %lld件、動画 %lld件、枚数レコード %lld件（%lld枚）、思い出 %lld件、添付 %lld件。\n削除は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %@？\n删除：Cheki %lld 项、写メ %lld 项、视频 %lld 项；数量记录 %lld 条（%lld 张）；回忆 %lld 条、附件 %lld 项。\n保留并解除关联：Cheki %lld 项、写メ %lld 项、视频 %lld 项；数量记录 %lld 条（%lld 张）；回忆 %lld 条、附件 %lld 项。\n删除无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 %@？\n刪除：Cheki %lld 項、寫メ %lld 項、影片 %lld 項；數量記錄 %lld 筆（%lld 張）；回憶 %lld 筆、附件 %lld 項。\n保留並解除關聯：Cheki %lld 項、寫メ %lld 項、影片 %lld 項；數量記錄 %lld 筆（%lld 張）；回憶 %lld 筆、附件 %lld 項。\n刪除無法復原。"
          }
        }
      }
    },
