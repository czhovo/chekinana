          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ この削除には画像の復元・クリーンアップが必要です。完了するまで「削除」または「復旧を再試行」をタップしてください。まだこの画面を閉じることはできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 此删除操作需要完成图片恢复或清理。请继续点按“删除”或“重试恢复”直到完成；当前还不能关闭此页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 此刪除操作需要完成圖片復原或清理。請繼續點一下「刪除」或「重試復原」直到完成；目前還無法關閉此頁面。"
          }
        }
      }
    },
