    "product.settings.signing.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on the embedded provisioning profile. Certificate validity and revocation cannot be verified here. Missing or unreadable profile details are shown as unavailable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵プロビジョニングプロファイルに基づく表示です。証明書の有効性や失効状況は確認できません。プロファイルがない場合や読み取れない場合は、取得できないと表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依据 App 内嵌描述文件显示，无法在此验证证书有效性或吊销状态。描述文件缺失或无法读取时显示不可获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依據 App 內嵌描述檔顯示，無法在此驗證憑證有效性或撤銷狀態。描述檔缺失或無法讀取時顯示無法取得。"
          }
        }
      }
    },
