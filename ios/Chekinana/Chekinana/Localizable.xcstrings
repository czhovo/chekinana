    "assistant.dialog.stats_basis" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only currently visible records are counted. Each Cheki with a photo counts as 1; records without photos use the saved quantity. Date ranges use the Cheki record date and include both start and end dates. Undated Cheki count only when no date range is set. Cheki shared by multiple Idols count for each Idol, but only once in the total."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在表示対象の記録のみ集計します。画像付きチェキは1件につき1枚、画像なしの記録は保存された枚数で数えます。期間はチェキの記録日を基準に開始日・終了日を含みます。記録日未設定のチェキは期間を指定しない場合のみ含めます。複数のアイドルに関連付けたチェキは各アイドルに計上しますが、合計では重複して数えません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅统计当前可见记录。有图拍立得每项计1张，无图记录按已保存数量统计。日期范围按拍立得记录日期计算，包含起止两天；无日期拍立得仅在不限日期时计入。多人拍立得分别计入各偶像，总量不重复计数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅統計目前可見記錄。有圖拍立得每項計 1 張，無圖記錄依已儲存數量統計。日期範圍依拍立得記錄日期計算，包含起迄兩天；無日期拍立得僅在不限日期時計入。多人拍立得分別計入各偶像，總量不重複計數。"
          }
        }
      }
    },
    "assistant.dialog.stats_excluded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
