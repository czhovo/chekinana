        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Date and Idol recognition are on by default; the Unassigned candidate is off. Images are stored locally; detection overlays are never written into saved or downloaded images."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付とアイドル認識は既定でオン、未割り当て候補はオフです。画像は端末内に保存され、検出枠は保存・ダウンロード画像に書き込まれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日期与偶像识别默认开启，未分配候选默认关闭。图片存于本机，检测框不会写入保存或下载的图片。"
          }
        }
      }
    },
