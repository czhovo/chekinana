    "product.settings.import.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuing will validate the selected backup and, if validation succeeds, automatically replace every local record, setting, and app-managed media file. Cancel to keep the current library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行すると選択したバックアップを検証し、検証に成功すると、すべてのローカル記録、設定、アプリ管理メディアを自動的に置き換えます。現在のライブラリを保持するにはキャンセルしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续后将验证所选备份，验证通过即自动替换全部本地记录、设置和由 App 管理的媒体文件。如需保留当前资料库，请取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續後將驗證所選備份，驗證通過即自動替換全部本機記錄、設定和由 App 管理的媒體檔案。如需保留目前的資料庫，請取消。"
          }
        }
      }
    },
