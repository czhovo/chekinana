    "(clears visible command history only)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(clears visible command history only)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（表示中のコマンド履歴のみ消去します）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（仅清空可见的命令历史）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（僅清空可見的指令歷史）"
          }
        }
      }
    },
    "(no code confirms the latest unambiguous operation)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(no code confirms the latest unambiguous operation)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（コードを省略すると、直前の曖昧でない操作を確認します）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（不提供确认码时，确认最近且无歧义的操作）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（未提供確認碼時，確認最近且無歧義的操作）"
          }
        }
      }
    },
    "(starts the managed backend when needed, then processes selected photos into temporary Cheki)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(starts the managed backend when needed, then processes selected photos into temporary Cheki)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（必要に応じて管理対象バックエンドを起動し、選択した写真から一時チェキを作成します）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（需要时启动托管后端，然后将所选照片处理为临时拍立得）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（需要時啟動受管理後端，然後將所選照片處理為暫存拍立得）"
          }
        }
      }
    },
    "(uses selected album photos; metadata is optional; idx is assigned once idol and date exist)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(uses selected album photos; metadata is optional; idx is assigned once idol and date exist)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（選択したアルバム写真を使用します。情報は任意で、idolとdateが設定されるとidxを割り当てます）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用已选相册照片；信息可选；idol 和 date 都存在后分配 idx）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（使用已選相簿照片；資訊可選填；idol 和 date 都存在後分配 idx）"
          }
        }
      }
    },
