        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加、検索、変更、削除したいアイドル・チェキ・イベントを教えてください。例えば「昨日Aliceとチェキを3枚撮った」「9月1日から9月10日まで、誰とチェキを撮った？」と話しかけてください。変更を保存する前にプレビューを表示するので、内容を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我想添加、查找、修改或删除哪个偶像、拍立得或活动。例如：“昨天和 Alice 切了3张”或“9月1日到9月10日都和谁拍了拍立得？”保存更改前，我会先给出预览，请你确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴我想新增、尋找、修改或刪除哪個偶像、拍立得或活動。例如：「昨天和 Alice 切了 3 張」或「9 月 1 日到 9 月 10 日都和誰拍了拍立得？」儲存變更前，我會先提供預覽，請你確認。"
          }
        }
      }
    },
